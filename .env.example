# CavGo backend — the Spring Boot GraphQL API (serves /graphql and /graphql WebSocket)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Nexxauth — identity provider (login/register with email or phone + password).
# Base URL includes the platform slug: https://auth.med.rw/master
NEXT_PUBLIC_NEXXAUTH_BASE_URL=https://auth.med.rw/master

# WEB client key registered in the Nexxauth organisation (X-Client-Id header).
# Get this from the Nexxauth console → organisation → clients → WEB client.
NEXT_PUBLIC_NEXXAUTH_CLIENT_ID=

# Supabase — used for Realtime notice feed ONLY (not auth).
# The notice_viewers table must be in the supabase_realtime publication.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Supabase Realtime setup (dashboard, once) ─────────────────────────────
# For the notice feed the worker portal subscribes directly to `notice_viewers`:
#   1. Add the `notice_viewers` table to the `supabase_realtime` publication.
#   2. Enable RLS on `notice_viewers` with a SELECT policy for the owner:
#        create policy "own notices" on notice_viewers
#        for select using (user_id = auth.uid());
#   3. (Optional, for DELETE events) ALTER TABLE notice_viewers REPLICA IDENTITY FULL;
